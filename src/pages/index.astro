---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import Personalized from '../components/Personalized.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import EnhancedLightbox from '../components/EnhancedLightbox.astro';

import { getCollection, getEntry } from 'astro:content';

// 1. Load Site Settings
const settingsEntry = await getEntry('settings', 'site');
const site = settingsEntry?.data ?? {
  siteName: "Solumar sports & lifestyle",
  tagline: "Catálogo Digital de Bolsas e Viseiras",
  description: "Catálogo digital Solumar sports & lifestyle: bolsas, mini shoulders, malas esportivas e viseiras. Peça pelo WhatsApp e receba em todo o Brasil.",
  phone: "(22) 99725-8528",
  whatsappNumber: "5522997258528",
  defaultMessage: "Olá, Solumar! Vi o catálogo digital e quero tirar uma dúvida.",
  instagramHandle: "@solu.mar",
  instagramUrl: "https://instagram.com/solu.mar",
  location: "Cabo Frio · Rio de Janeiro",
  announcement: "Catálogo digital 2026",
  hero: {
    badge: "Catálogo digital 2026",
    title: "Esporte, estilo e liberdade",
    subtitle: "Bolsas, mini shoulders, malas esportivas e viseiras feitas para quem vive em movimento. De Cabo Frio para todo o Brasil.",
    image: "/images/hero-canoa.jpg",
    highlights: [
      { icon: "truck", text: "Entregamos para todo o Brasil" },
      { icon: "map-pin", text: "Cabo Frio · Rio de Janeiro" },
      { icon: "droplets", text: "Materiais resistentes à água e areia" }
    ]
  },
  personalized: {
    badge: "Sob medida",
    title: "Personalizados para a sua equipe",
    description: "Viseiras e bonés com a identidade do seu time, evento ou empresa. Sublimação total, bordado e acabamento premium.",
    items: [
      { title: "Viseira", rows: ["Pedido mínimo: 30 unidades", "Valores sob consulta"] },
      { title: "Boné", rows: ["Pedido mínimo: 30 unidades", "Valores sob consulta"] }
    ],
    notice: "Prazo de entrega: 30 dias úteis · Pagamento: 50% no pedido e 50% na entrega.",
    ctaText: "Pedir orçamento",
    gallery: [
      "/images/pers-viseira.jpg",
      "/images/pers-bone.jpg",
      "/images/pers-trucker.jpg"
    ]
  },
  cta: {
    title: "Gostou de algum modelo?",
    description: "Chame a gente no WhatsApp para conferir cores disponíveis, formas de pagamento e frete para a sua cidade.",
    buttonText: "(22) 99725-8528"
  }
};

// 2. Load Products Collection
const productEntries = await getCollection('products');
const allProducts = productEntries.map((p) => p.data);

// Separate catalog products from custom product if needed
const catalogProducts = allProducts.filter((p) => p.id !== 'personalizados');

// Encoded default WhatsApp URL
const defaultWaMsg = encodeURIComponent(site.defaultMessage);
const mainWhatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${defaultWaMsg}`;

const pageTitle = `${site.siteName} | ${site.tagline}`;
---

<Layout title={pageTitle} description={site.description}>
  <!-- Fixed Header (with Announcement Bar) -->
  <Header
    phone={site.phone}
    whatsappUrl={mainWhatsappUrl}
    instagramUrl={site.instagramUrl}
    instagramHandle={site.instagramHandle}
    announcement={site.announcement}
    location={site.location}
  />

  <main class="pt-[96px] sm:pt-[116px]">
    <!-- Hero Section -->
    <Hero
      badge={site.hero.badge}
      title={site.hero.title}
      subtitle={site.hero.subtitle}
      image={site.hero.image}
      whatsappUrl={mainWhatsappUrl}
      highlights={site.hero.highlights}
    />

    <!-- Catalog Section with Filter and Cards -->
    <Catalog
      products={catalogProducts}
      whatsappNumber={site.whatsappNumber}
    />

    <!-- Personalized Section -->
    <Personalized
      badge={site.personalized.badge}
      title={site.personalized.title}
      description={site.personalized.description}
      items={site.personalized.items}
      notice={site.personalized.notice}
      ctaText={site.personalized.ctaText}
      gallery={site.personalized.gallery}
      whatsappNumber={site.whatsappNumber}
    />

    <!-- Contact & Final CTA Section -->
    <ContactCta
      title={site.cta.title}
      description={site.cta.description}
      phone={site.phone}
      whatsappUrl={mainWhatsappUrl}
      location={site.location}
    />
  </main>

  <!-- Footer -->
  <Footer
    siteName={site.siteName}
    instagramHandle={site.instagramHandle}
    instagramUrl={site.instagramUrl}
    whatsappUrl={mainWhatsappUrl}
    phone={site.phone}
    location={site.location}
  />

  <!-- Floating WhatsApp CTA button -->
  <FloatingWhatsApp whatsappUrl={mainWhatsappUrl} />

  <!-- Enhanced Lightbox Modal (handles all products and personalized gallery) -->
  <EnhancedLightbox
    products={allProducts}
    whatsappNumber={site.whatsappNumber}
  />
</Layout>
