---
interface Product {
  id: string;
  title: string;
  tagline: string;
  price?: string;
  category: string;
  images: string[];
  details: string[];
}

interface Props {
  products: Product[];
  whatsappNumber: string;
}

const { products, whatsappNumber } = Astro.props;

// Pass JSON data safely to client script
const productsPayload = JSON.stringify(
  products.map((p) => ({
    id: p.id,
    title: p.title,
    price: p.price || '',
    category: p.category,
    images: p.images,
    details: p.details,
  }))
);
---

<!-- Lightbox Modal Container (Guaranteed NO scrollbar) -->
<div
  id="enhanced-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Galeria de fotos do produto"
  class="pointer-events-none fixed inset-0 z-50 flex h-dvh max-h-dvh w-full flex-col overflow-hidden opacity-0 invisible transition-opacity duration-300 bg-brand-navy/95 backdrop-blur-md select-none"
  data-products={productsPayload}
  data-whatsapp={whatsappNumber}
>
  <!-- Top Bar Controls -->
  <header class="relative z-20 shrink-0 flex h-14 sm:h-16 items-center justify-between px-4 sm:px-6 border-b border-white/10 bg-brand-navy/90">
    <div class="flex items-center gap-3 min-w-0">
      <span class="shrink-0 rounded-full bg-brand-lime/20 px-3 py-1 text-xs font-bold text-brand-lime">
        <span id="lb-counter">1 de 1</span>
      </span>
      <h3 id="lb-title" class="font-display text-base font-semibold text-white sm:text-xl truncate max-w-[180px] sm:max-w-md">
        Produto
      </h3>
      <span id="lb-price" class="hidden sm:inline-block shrink-0 rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-bold text-brand-lime">
        R$ 0,00
      </span>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <!-- Zoom Toggle Button -->
      <button
        id="lb-zoom-btn"
        type="button"
        aria-label="Alternar zoom"
        title="Alternar Zoom"
        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-white/10 text-white transition-all hover:bg-white/20 hover:scale-105"
      >
        <svg id="lb-zoom-in-icon" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
        </svg>
        <svg id="lb-zoom-out-icon" class="hidden h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7" />
        </svg>
      </button>

      <!-- Close Button -->
      <button
        id="lb-close-btn"
        type="button"
        aria-label="Fechar galeria (Esc)"
        title="Fechar (Esc)"
        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-white/10 text-white transition-all hover:bg-white/20 hover:scale-105"
      >
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </header>

  <!-- Main Image Stage (Strictly overflow-hidden) -->
  <main class="relative flex flex-1 min-h-0 w-full items-center justify-center overflow-hidden p-2 sm:p-4">
    <!-- Prev Button -->
    <button
      id="lb-prev-btn"
      type="button"
      aria-label="Foto anterior (Seta esquerda)"
      class="absolute left-2 sm:left-6 z-20 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-brand-navy/70 border border-white/20 text-white shadow-xl backdrop-blur-md transition-all hover:bg-brand-navy hover:scale-110"
    >
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Image Viewport (Zero Scrollbars) -->
    <div id="lb-viewport" class="relative flex h-full w-full items-center justify-center overflow-hidden cursor-zoom-in">
      <img
        id="lb-image"
        src=""
        alt="Foto do produto ampliada"
        class="max-h-[50vh] sm:max-h-[56vh] md:max-h-[58vh] max-w-[86vw] sm:max-w-[78vw] w-auto h-auto select-none object-contain transition-transform duration-300 drop-shadow-2xl"
      />
    </div>

    <!-- Next Button -->
    <button
      id="lb-next-btn"
      type="button"
      aria-label="Próxima foto (Seta direita)"
      class="absolute right-2 sm:right-6 z-20 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-brand-navy/70 border border-white/20 text-white shadow-xl backdrop-blur-md transition-all hover:bg-brand-navy hover:scale-110"
    >
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </main>

  <!-- Bottom Strip & Action Area (Compact, shrink-0, zero scrollbar) -->
  <footer class="relative z-20 shrink-0 flex flex-col items-center gap-2 border-t border-white/10 bg-brand-navy/90 px-4 py-2.5 sm:px-6 sm:py-3 backdrop-blur-md">
    <!-- Thumbnails carousel with hidden scrollbar -->
    <div
      id="lb-thumbnails"
      class="lb-thumbs-no-scroll flex max-w-xl items-center justify-center gap-2 overflow-x-auto py-1"
      style="-ms-overflow-style: none; scrollbar-width: none;"
    >
      <!-- Injected via JavaScript -->
    </div>

    <!-- Product Details and Direct WhatsApp Link -->
    <div class="flex w-full max-w-2xl items-center justify-between gap-3">
      <div class="text-left min-w-0 flex-1">
        <p id="lb-bottom-details" class="text-xs text-brand-sand/80 truncate">
          Material impermeável, fácil de limpar
        </p>
      </div>

      <a
        id="lb-whatsapp-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-brand-lime px-5 py-2 text-xs font-bold uppercase tracking-wider text-brand-navy shadow-soft transition-all duration-300 hover:scale-105 hover:bg-[#b0f56e] hover:shadow-glow-lime"
      >
        <svg class="h-3.5 w-3.5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.45.06-.68.32-.23.25-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.79 2.74 4.34 3.84.61.26 1.08.42 1.45.54.61.19 1.17.17 1.61.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/>
        </svg>
        <span class="leading-none">Pedir no WhatsApp</span>
      </a>
    </div>
  </footer>
</div>

<style>
  /* Suppress scrollbars across all browsers in lightbox */
  #enhanced-lightbox,
  #enhanced-lightbox * {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #enhanced-lightbox *::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
</style>

<script>
  interface ClientProduct {
    id: string;
    title: string;
    price: string;
    category: string;
    images: string[];
    details: string[];
  }

  function initEnhancedLightbox() {
    const modal = document.getElementById('enhanced-lightbox');
    if (!modal) return;

    const rawData = modal.getAttribute('data-products') || '[]';
    const whatsappNumber = modal.getAttribute('data-whatsapp') || '5522997258528';
    let products: ClientProduct[] = [];
    try {
      products = JSON.parse(rawData);
    } catch (e) {
      console.error('Failed to parse products payload for lightbox:', e);
    }

    const imgEl = document.getElementById('lb-image') as HTMLImageElement;
    const titleEl = document.getElementById('lb-title');
    const priceEl = document.getElementById('lb-price');
    const counterEl = document.getElementById('lb-counter');
    const detailsEl = document.getElementById('lb-bottom-details');
    const waLinkEl = document.getElementById('lb-whatsapp-link') as HTMLAnchorElement;
    const thumbsContainer = document.getElementById('lb-thumbnails');
    const closeBtn = document.getElementById('lb-close-btn');
    const prevBtn = document.getElementById('lb-prev-btn');
    const nextBtn = document.getElementById('lb-next-btn');
    const zoomBtn = document.getElementById('lb-zoom-btn');
    const zoomInIcon = document.getElementById('lb-zoom-in-icon');
    const zoomOutIcon = document.getElementById('lb-zoom-out-icon');

    let currentProduct: ClientProduct | null = null;
    let currentImageIndex = 0;
    let isZoomed = false;

    // Helper: update modal contents
    function renderCurrentView() {
      if (!currentProduct || currentProduct.images.length === 0) return;
      const total = currentProduct.images.length;
      const src = currentProduct.images[currentImageIndex];

      if (imgEl) {
        imgEl.src = src;
        imgEl.alt = `${currentProduct.title} - Foto ${currentImageIndex + 1}`;
        imgEl.style.transform = isZoomed ? 'scale(1.45)' : 'scale(1)';
      }

      if (titleEl) titleEl.textContent = currentProduct.title;
      if (priceEl) {
        if (currentProduct.price) {
          priceEl.textContent = currentProduct.price;
          priceEl.classList.remove('hidden');
        } else {
          priceEl.classList.add('hidden');
        }
      }

      if (counterEl) {
        counterEl.textContent = `${currentImageIndex + 1} de ${total}`;
      }

      if (detailsEl) {
        detailsEl.textContent = currentProduct.details.join(' · ');
      }

      if (waLinkEl) {
        const msg = encodeURIComponent(
          `Olá, Solumar! Estou vendo a foto ${currentImageIndex + 1} de ${currentProduct.title}${currentProduct.price ? ` (${currentProduct.price})` : ''} e tenho interesse.`
        );
        waLinkEl.href = `https://wa.me/${whatsappNumber}?text=${msg}`;
      }

      // Prev / Next button visibility
      if (prevBtn && nextBtn) {
        if (total <= 1) {
          prevBtn.classList.add('hidden');
          nextBtn.classList.add('hidden');
        } else {
          prevBtn.classList.remove('hidden');
          nextBtn.classList.remove('hidden');
        }
      }

      // Render thumbnail items
      if (thumbsContainer) {
        thumbsContainer.innerHTML = '';
        if (total > 1) {
          currentProduct.images.forEach((thumbSrc, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('aria-label', `Ir para foto ${idx + 1}`);
            btn.className = `relative h-10 w-10 sm:h-11 sm:w-11 shrink-0 overflow-hidden rounded-xl border-2 transition-all p-0.5 bg-brand-navy/60 ${
              idx === currentImageIndex ? 'border-brand-lime scale-105 shadow-glow-lime' : 'border-white/20 opacity-50 hover:opacity-100'
            }`;
            const tImg = document.createElement('img');
            tImg.src = thumbSrc;
            tImg.alt = `Miniatura ${idx + 1}`;
            tImg.className = 'h-full w-full object-contain';
            btn.appendChild(tImg);
            btn.addEventListener('click', () => {
              currentImageIndex = idx;
              isZoomed = false;
              updateZoomIcons();
              renderCurrentView();
            });
            thumbsContainer.appendChild(btn);
          });
          thumbsContainer.classList.remove('hidden');
        } else {
          thumbsContainer.classList.add('hidden');
        }
      }
    }

    function updateZoomIcons() {
      if (isZoomed) {
        zoomInIcon?.classList.add('hidden');
        zoomOutIcon?.classList.remove('hidden');
      } else {
        zoomInIcon?.classList.remove('hidden');
        zoomOutIcon?.classList.add('hidden');
      }
    }

    function openModal(productId: string, initialIndex = 0) {
      const prod = products.find((p) => p.id === productId);
      if (!prod) return;

      currentProduct = prod;
      currentImageIndex = initialIndex < prod.images.length ? initialIndex : 0;
      isZoomed = false;
      updateZoomIcons();

      renderCurrentView();

      modal?.classList.remove('pointer-events-none', 'opacity-0', 'invisible');
      modal?.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('pointer-events-none', 'opacity-0', 'invisible');
      modal?.classList.remove('opacity-100');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      isZoomed = false;
      updateZoomIcons();
      if (imgEl) imgEl.style.transform = 'scale(1)';
    }

    function nextImage() {
      if (!currentProduct || currentProduct.images.length <= 1) return;
      currentImageIndex = (currentImageIndex + 1) % currentProduct.images.length;
      isZoomed = false;
      updateZoomIcons();
      renderCurrentView();
    }

    function prevImage() {
      if (!currentProduct || currentProduct.images.length <= 1) return;
      currentImageIndex = (currentImageIndex - 1 + currentProduct.images.length) % currentProduct.images.length;
      isZoomed = false;
      updateZoomIcons();
      renderCurrentView();
    }

    function toggleZoom() {
      isZoomed = !isZoomed;
      updateZoomIcons();
      if (imgEl) {
        imgEl.style.transform = isZoomed ? 'scale(1.45)' : 'scale(1)';
      }
    }

    // Attach click events on triggers across page
    document.querySelectorAll('[data-open-lightbox]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const pId = trigger.getAttribute('data-open-lightbox');
        const imgIdx = parseInt(trigger.getAttribute('data-img-index') || '0', 10);
        if (pId) openModal(pId, imgIdx);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    prevBtn?.addEventListener('click', prevImage);
    nextBtn?.addEventListener('click', nextImage);
    zoomBtn?.addEventListener('click', toggleZoom);

    // Click on image toggles zoom
    imgEl?.addEventListener('click', toggleZoom);

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('opacity-0')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });

    // Touch Swipe Navigation for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    const viewport = document.getElementById('lb-viewport');

    viewport?.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    viewport?.addEventListener(
      'touchend',
      (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 50) {
          if (diff < 0) {
            nextImage();
          } else {
            prevImage();
          }
        }
      },
      { passive: true }
    );
  }

  initEnhancedLightbox();
  document.addEventListener('astro:page-load', initEnhancedLightbox);
</script>
