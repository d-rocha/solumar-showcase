---
interface Props {
  siteName: string;
  instagramHandle: string;
  instagramUrl: string;
  whatsappUrl: string;
  phone: string;
  location: string;
}

const { siteName, instagramHandle, instagramUrl, whatsappUrl, phone, location } = Astro.props;
---

<footer class="border-t border-neutral-200 bg-white py-12 text-sm text-neutral-600 overflow-hidden">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8">
    <!-- Brand -->
    <div class="flex flex-col items-center sm:items-start gap-2">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt={siteName} class="h-10 w-auto" />
        <span class="font-display font-bold text-brand-navy text-lg">Solumar</span>
      </div>
      <p class="text-xs text-neutral-500">
        Sports & Lifestyle · {location}
      </p>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold uppercase tracking-wider text-neutral-500">
      <a href="#catalogo" class="hover:text-brand-navy transition-colors">
        Catálogo
      </a>
      <a href="#personalizados" class="hover:text-brand-navy transition-colors">
        Personalizados
      </a>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-brand-navy transition-colors flex items-center gap-1"
      >
        <span>Instagram</span>
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-brand-navy transition-colors flex items-center gap-1.5 text-emerald-600 font-bold"
      >
        <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M187.3,159.06A36.09,36.09,0,0,1,152,188a84.09,84.09,0,0,1-84-84A36.09,36.09,0,0,1,96.94,68.7,12,12,0,0,1,110,75.1l11.48,23a12,12,0,0,1-.75,12l-8.52,12.78a44.56,44.56,0,0,0,20.91,20.91l12.78-8.52a12,12,0,0,1,12-.75l23,11.48A12,12,0,0,1,187.3,159.06ZM236,128A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Copyright -->
    <div class="text-center sm:text-right text-xs text-neutral-400">
      <p>© {new Date().getFullYear()} {siteName}.</p>
      <p class="mt-0.5">Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
