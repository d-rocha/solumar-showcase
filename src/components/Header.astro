---
interface Props {
  phone: string;
  whatsappUrl: string;
  instagramUrl: string;
  instagramHandle: string;
  announcement?: string;
  location?: string;
}

const { phone, whatsappUrl, instagramUrl, instagramHandle, announcement, location } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-40 w-full border-b border-neutral-100 bg-white/95 backdrop-blur-md transition-all shadow-xs">
  {announcement && (
    <div class="bg-brand-navy py-2 text-center text-xs font-semibold uppercase tracking-wider text-brand-sand">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-4">
        <span class="hidden md:inline-block h-1.5 w-1.5 rounded-full bg-brand-lime"></span>
        <span>{announcement} {location ? `· Entregamos para todo o Brasil direto de ${location}` : ''}</span>
      </div>
    </div>
  )}

  <div class="mx-auto flex h-16 sm:h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="#" class="group flex items-center gap-3 transition-transform hover:scale-[1.02]">
      <img
        src="/logo.png"
        alt="Solumar sports & lifestyle"
        class="h-10 w-auto object-contain sm:h-14"
        loading="eager"
      />
      <div class="hidden flex-col sm:flex">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
          Cabo Frio · RJ
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 md:flex">
      <a
        href="#catalogo"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Catálogo
      </a>
      <a
        href="#personalizados"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Personalizados
      </a>
      <a
        href="#contato"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Contato
      </a>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        {instagramHandle}
      </a>
    </nav>

    <!-- Desktop WhatsApp CTA Button -->
    <div class="hidden items-center gap-4 md:flex">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-lime px-5 py-2.5 text-sm font-bold text-brand-navy shadow-soft transition-all duration-300 hover:scale-105 hover:bg-[#b0f56e] hover:shadow-glow-lime"
      >
        <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M187.3,159.06A36.09,36.09,0,0,1,152,188a84.09,84.09,0,0,1-84-84A36.09,36.09,0,0,1,96.94,68.7,12,12,0,0,1,110,75.1l11.48,23a12,12,0,0,1-.75,12l-8.52,12.78a44.56,44.56,0,0,0,20.91,20.91l12.78-8.52a12,12,0,0,1,12-.75l23,11.48A12,12,0,0,1,187.3,159.06ZM236,128A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"/></svg>
        <span class="leading-none">Falar no WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Header Actions (WhatsApp Only) -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-lime px-3.5 py-1.5 text-xs font-bold text-brand-navy shadow-xs transition-all active:scale-95"
        aria-label="Falar no WhatsApp"
      >
        <svg class="h-3.5 w-3.5 shrink-0 fill-current" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M187.3,159.06A36.09,36.09,0,0,1,152,188a84.09,84.09,0,0,1-84-84A36.09,36.09,0,0,1,96.94,68.7,12,12,0,0,1,110,75.1l11.48,23a12,12,0,0,1-.75,12l-8.52,12.78a44.56,44.56,0,0,0,20.91,20.91l12.78-8.52a12,12,0,0,1,12-.75l23,11.48A12,12,0,0,1,187.3,159.06ZM236,128A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</header>
