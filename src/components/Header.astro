---
interface Props {
  phone: string;
  whatsappUrl: string;
  instagramUrl: string;
  instagramHandle: string;
}

const { phone, whatsappUrl, instagramUrl, instagramHandle } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-neutral-100 bg-white/95 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="#" class="group flex items-center gap-3 transition-transform hover:scale-[1.02]">
      <img
        src="/logo.png"
        alt="Solumar sports & lifestyle"
        class="h-12 w-auto object-contain sm:h-14"
        loading="eager"
      />
      <div class="hidden flex-col sm:flex">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
          Cabo Frio · RJ
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 md:flex">
      <a
        href="#catalogo"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Catálogo
      </a>
      <a
        href="#personalizados"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Personalizados
      </a>
      <a
        href="#contato"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        Contato
      </a>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-brand-navy/80 transition-colors hover:text-brand-navy"
      >
        {instagramHandle}
      </a>
      <a
        href="/admin/"
        class="text-xs font-semibold text-neutral-400 transition-colors hover:text-brand-navy"
        title="Painel Decap CMS"
      >
        Admin
      </a>
    </nav>

    <!-- Desktop WhatsApp CTA Button -->
    <div class="hidden items-center gap-4 md:flex">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-brand-lime px-5 py-2.5 text-sm font-bold text-brand-navy shadow-soft transition-all duration-300 hover:scale-105 hover:bg-[#b0f56e] hover:shadow-glow-lime"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 32 32">
          <path d="M16 2a13.9 13.9 0 0 0-12 21L2 30l7.3-1.9A13.9 13.9 0 1 0 16 2zm0 25.5a11.5 11.5 0 0 1-5.9-1.6l-.4-.3-4.4 1.1 1.2-4.3-.3-.4A11.6 11.6 0 1 1 16 27.5zm6.4-8.6c-.3-.2-2-.9-2.3-1s-.6-.2-.8.2-.9 1.1-1.1 1.3-.4.2-.7.1a9 9 0 0 1-2.6-1.6 10 10 0 0 1-1.8-2.3c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.3-.4.4-.6s0-.4 0-.6-.8-2-1.1-2.7c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.7.1-1.1.5s-1.5 1.5-1.5 3.6 1.6 4.1 1.8 4.4c.2.3 3.1 4.7 7.5 6.6 1 .4 1.8.7 2.5.9 1.1.3 2 .3 2.8.2.9-.1 2-.8 2.3-1.6s.3-1.5.2-1.6c-.1-.2-.4-.3-.7-.5z"/>
        </svg>
        <span>Falar no WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      class="flex h-11 w-11 items-center justify-center rounded-xl border border-neutral-200 text-brand-navy transition-colors hover:bg-neutral-50 md:hidden"
    >
      <svg id="menu-icon-bars" class="h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Slide-over Drawer -->
  <div
    id="mobile-drawer"
    class="pointer-events-none fixed inset-0 z-50 flex transition-opacity duration-300 opacity-0"
  >
    <!-- Backdrop -->
    <div id="mobile-backdrop" class="fixed inset-0 bg-brand-navy/60 backdrop-blur-sm"></div>

    <!-- Drawer Panel -->
    <div class="relative ml-auto flex h-full w-full max-w-xs flex-col bg-white p-6 shadow-2xl transition-transform duration-300 translate-x-full">
      <div class="flex items-center justify-between pb-6 border-b border-neutral-100">
        <img src="/logo.png" alt="Solumar" class="h-10 w-auto" />
        <button
          id="mobile-close-btn"
          type="button"
          aria-label="Fechar menu"
          class="flex h-10 w-10 items-center justify-center rounded-lg text-neutral-500 hover:bg-neutral-100"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="mt-6 flex flex-col gap-4 text-base font-medium">
        <a href="#catalogo" class="mobile-nav-link rounded-xl p-3 text-brand-navy hover:bg-neutral-50">
          Catálogo Completo
        </a>
        <a href="#personalizados" class="mobile-nav-link rounded-xl p-3 text-brand-navy hover:bg-neutral-50">
          Viseiras e Bonés Personalizados
        </a>
        <a href="#contato" class="mobile-nav-link rounded-xl p-3 text-brand-navy hover:bg-neutral-50">
          Como Comprar / Contato
        </a>
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center gap-2 rounded-xl p-3 text-brand-navy hover:bg-neutral-50"
        >
          <span>Instagram ({instagramHandle})</span>
        </a>
        <a href="/admin/" class="mobile-nav-link rounded-xl p-3 text-xs font-semibold text-neutral-400 hover:text-brand-navy">
          Painel Decap CMS
        </a>
      </nav>

      <div class="mt-auto pt-6 border-t border-neutral-100">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-2 rounded-2xl bg-brand-lime py-3.5 text-center text-sm font-bold text-brand-navy shadow-soft"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 32 32">
            <path d="M16 2a13.9 13.9 0 0 0-12 21L2 30l7.3-1.9A13.9 13.9 0 1 0 16 2zm0 25.5a11.5 11.5 0 0 1-5.9-1.6l-.4-.3-4.4 1.1 1.2-4.3-.3-.4A11.6 11.6 0 1 1 16 27.5zm6.4-8.6c-.3-.2-2-.9-2.3-1s-.6-.2-.8.2-.9 1.1-1.1 1.3-.4.2-.7.1a9 9 0 0 1-2.6-1.6 10 10 0 0 1-1.8-2.3c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.3-.4.4-.6s0-.4 0-.6-.8-2-1.1-2.7c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.7.1-1.1.5s-1.5 1.5-1.5 3.6 1.6 4.1 1.8 4.4c.2.3 3.1 4.7 7.5 6.6 1 .4 1.8.7 2.5.9 1.1.3 2 .3 2.8.2.9-.1 2-.8 2.3-1.6s.3-1.5.2-1.6c-.1-.2-.4-.3-.7-.5z"/>
          </svg>
          <span>Falar no WhatsApp</span>
        </a>
        <p class="mt-3 text-center text-xs text-neutral-400">
          Cabo Frio · Rio de Janeiro
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');
    const closeBtn = document.getElementById('mobile-close-btn');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !drawer) return;

    function openMenu() {
      drawer?.classList.remove('pointer-events-none', 'opacity-0');
      drawer?.classList.add('opacity-100');
      drawer?.querySelector('div.relative')?.classList.remove('translate-x-full');
      drawer?.querySelector('div.relative')?.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
      btn?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      drawer?.classList.add('pointer-events-none', 'opacity-0');
      drawer?.classList.remove('opacity-100');
      drawer?.querySelector('div.relative')?.classList.add('translate-x-full');
      drawer?.querySelector('div.relative')?.classList.remove('translate-x-0');
      document.body.style.overflow = '';
      btn?.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);
    links.forEach((l) => l.addEventListener('click', closeMenu));
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
