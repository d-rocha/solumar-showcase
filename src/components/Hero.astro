---
interface Props {
  badge: string;
  title: string;
  subtitle: string;
  image: string;
  whatsappUrl: string;
  highlights: Array<{ icon: string; text: string }>;
}

const { badge, title, subtitle, image, whatsappUrl, highlights } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-navy text-white">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt="Solumar Esporte e Liberdade"
      class="h-full w-full object-cover object-center opacity-30 md:opacity-40 filter saturate-110"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/70 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/90 via-brand-navy/50 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <div class="max-w-2xl">
      <!-- Badge Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-lime/30 bg-brand-navy/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-brand-lime backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-lime opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-lime"></span>
        </span>
        {badge}
      </div>

      <!-- Main Headline -->
      <h1 class="font-display mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl sm:leading-[1.1] lg:text-7xl">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg leading-relaxed text-brand-sand/85 sm:text-xl">
        {subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#catalogo"
          class="inline-flex items-center justify-center rounded-full bg-brand-lime px-8 py-3.5 text-base font-bold text-brand-navy shadow-soft transition-all duration-300 hover:scale-105 hover:bg-[#b0f56e] hover:shadow-glow-lime"
        >
          Ver catálogo
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/20 bg-white/10 px-7 py-3.5 text-base font-medium text-white backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-white/40 hover:bg-white/20"
        >
          <svg class="h-5 w-5 shrink-0 fill-current text-brand-lime" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.45.06-.68.32-.23.25-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.79 2.74 4.34 3.84.61.26 1.08.42 1.45.54.61.19 1.17.17 1.61.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/>
          </svg>
          <span class="leading-none">Falar agora</span>
        </a>
      </div>
    </div>

    <!-- Highlights Bar -->
    <div class="mt-16 border-t border-white/10 pt-8 sm:mt-24">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {highlights.map((h) => (
          <div class="flex items-center gap-3.5 text-sm text-brand-sand/85">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-brand-lime">
              {h.icon === 'truck' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
              )}
              {h.icon === 'map-pin' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              {h.icon === 'droplets' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              )}
            </div>
            <span class="font-medium">{h.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
