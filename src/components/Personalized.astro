---
interface Props {
  badge: string;
  title: string;
  description: string;
  items: Array<{
    title: string;
    rows: string[];
  }>;
  notice: string;
  ctaText: string;
  gallery: string[];
  whatsappNumber: string;
}

const { badge, title, description, items, notice, ctaText, gallery, whatsappNumber } = Astro.props;
const waMsg = encodeURIComponent("Olá, Solumar! Quero um orçamento de viseiras/bonés personalizados para minha equipe/evento.");
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMsg}`;
---

<section id="personalizados" class="relative overflow-hidden bg-brand-navy py-20 text-white sm:py-28 scroll-mt-20">
  <!-- Subtle decorative background gradient -->
  <div class="pointer-events-none absolute -right-40 -top-40 h-96 w-96 rounded-full bg-brand-accent/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-40 -bottom-40 h-96 w-96 rounded-full bg-brand-lime/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column: Copy & Rules -->
      <div class="lg:col-span-6">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-lime/30 bg-white/5 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-brand-lime">
          {badge}
        </span>

        <h2 class="font-display mt-4 text-3xl font-semibold sm:text-5xl lg:leading-tight">
          {title}
        </h2>

        <p class="mt-4 text-base leading-relaxed text-brand-sand/80 sm:text-lg">
          {description}
        </p>

        <!-- Product Cards -->
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {items.map((it) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:border-brand-lime/30 hover:bg-white/10">
              <h3 class="font-display text-2xl font-bold text-brand-lime">
                {it.title}
              </h3>
              <ul class="mt-3 space-y-2 text-xs leading-relaxed text-brand-sand/80">
                {it.rows.map((r) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-lime"></span>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Terms / Notice -->
        <p class="mt-6 text-xs text-brand-sand/65">
          {notice}
        </p>

        <!-- CTA Button -->
        <div class="mt-8">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-brand-lime px-8 py-3.5 text-sm font-bold text-brand-navy shadow-soft transition-all duration-300 hover:scale-105 hover:bg-[#b0f56e] hover:shadow-glow-lime"
          >
            <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M187.3,159.06A36.09,36.09,0,0,1,152,188a84.09,84.09,0,0,1-84-84A36.09,36.09,0,0,1,96.94,68.7,12,12,0,0,1,110,75.1l11.48,23a12,12,0,0,1-.75,12l-8.52,12.78a44.56,44.56,0,0,0,20.91,20.91l12.78-8.52a12,12,0,0,1,12-.75l23,11.48A12,12,0,0,1,187.3,159.06ZM236,128A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"/></svg>
            <span class="leading-none">{ctaText}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Gallery Grid -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-2 gap-4">
          {gallery.map((img, idx) => (
            <div
              class={`group relative overflow-hidden rounded-3xl border border-white/10 bg-neutral-900 shadow-xl ${
                idx === 0 ? 'col-span-2 aspect-16/10' : 'aspect-square'
              }`}
            >
              <button
                type="button"
                data-open-lightbox="personalizados"
                data-img-index={idx}
                aria-label={`Ampliar foto ${idx + 1} de personalizados`}
                class="block h-full w-full cursor-zoom-in text-left focus:outline-none"
              >
                <img
                  src={img}
                  alt={`Personalizados Solumar ${idx + 1}`}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </button>
              <div class="pointer-events-none absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-brand-navy/70 text-brand-lime opacity-0 backdrop-blur-sm transition-all group-hover:opacity-100 group-hover:scale-105">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
