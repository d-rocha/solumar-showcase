{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/backoffice/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/backoffice/:path*",
      "permanent": true
    }
  ]
}
